{
  "name": "@shba007/unchill",
  "version": "0.0.0",
  "description": "UnChill Notion Bot",
  "author": "Shirsendu Bairagi <shirsendu2001@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/shba007/unchill-bot.git"
  },
  "keywords": [],
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.mjs",
      "require": "./dist/cli.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "bin": {
    "unchill": "./bin/unchill.mjs"
  },
  "files": [
    "dist",
    "bin"
  ],
  "volta": {
    "node": "22.14.0"
  },
  "engines": {
    "node": "^20.15.0 || ^22.11.0",
    "pnpm": "^9.15.0 || ^10.2.0"
  },
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "prepare": "husky || true",
    "dev": "vitest dev",
    "detect": "gitleaks git --verbose",
    "lint": "eslint . --fix",
    "format": "prettier . --write",
    "test:types": "tsc --noEmit --skipLibCheck",
    "test": "pnpm lint && pnpm test:types && vitest run --coverage",
    "play": "dotenvx run -- jiti playground",
    "build": "unbuild",
    "prepack": "pnpm build",
    "release": "pnpm test && changelogen --release && pnpm publish && git push --follow-tags",
    "clean": "rm -rf coverage dist",
    "unchill": "node bin/unchill.mjs"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.10.1",
    "@notionhq/client": "^2.3.0",
    "chalk": "^5.6.2",
    "citty": "^0.2.2",
    "consola": "^3.4.2",
    "ofetch": "^1.5.1",
    "pathe": "^2.0.3"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@dotenvx/dotenvx": "^1.75.1",
    "@types/node": "^22.20.1",
    "@vitest/coverage-v8": "^3.2.7",
    "changelogen": "^0.6.2",
    "eslint": "^9.39.5",
    "eslint-config-unjs": "^0.6.2",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "unbuild": "3.6.1",
    "vitest": "^3.2.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "canvas",
      "esbuild"
    ]
  }
}